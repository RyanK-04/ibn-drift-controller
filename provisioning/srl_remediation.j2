[
  {
    "action": "replace",
    "path": "/acl/acl-filter[name={{ acl_name }}][type=ipv4]",
    "value": {
      "name": "{{ acl_name }}",
      "type": "ipv4",
      "entry": [
        {
          "sequence-id": 10,
          "action": {"drop": {}},
          "match": {
            "ipv4": {"protocol": 6},
            "transport": {"destination-port": {"value": {{ drop_port }}}}
          }
        }
      ]
    }
  },
  {
    "action": "update",
    "path": "/system/banner/login-banner",
    "value": {{ expected_banner | tojson }}
  }
{% for iface in interfaces %}
  ,
  {
    "action": "update",
    "path": "/interface[name={{ iface }}]/mtu",
    "value": 9000
  }
{% endfor %}
{% if routing_protocol == "ospfv2" and router_id %}
  ,
  {
    "action": "update",
    "path": "/network-instance[name=default]/protocols/ospf/instance[name=default]/admin-state",
    "value": "enable"
  },
  {
    "action": "update",
    "path": "/network-instance[name=default]/protocols/ospf/instance[name=default]/version",
    "value": "ospf-v2"
  },
  {
    "action": "update",
    "path": "/network-instance[name=default]/protocols/ospf/instance[name=default]/router-id",
    "value": {{ router_id | tojson }}
  }
{% for iface in interfaces %}
  ,
  {
    "action": "update",
    "path": "/network-instance[name=default]/protocols/ospf/instance[name=default]/area[area-id={{ area_id }}]/interface[interface-name={{ iface }}.0]/interface-type",
    "value": "point-to-point"
  },
  {
    "action": "update",
    "path": "/network-instance[name=default]/interface",
    "value": {"name": "{{ iface }}.0"}
  }
{% endfor %}
{% if vlan_interfaces %}
{% for vlan in vlan_interfaces %}
  ,
  {
    "action": "update",
    "path": "/network-instance[name=default]/protocols/ospf/instance[name=default]/area[area-id={{ area_id }}]/interface[interface-name={{ vlan.port }}.{{ vlan.subinterface_index }}]/passive",
    "value": true
  }
{% endfor %}
{% endif %}
{% endif %}
{% for vlan in vlan_interfaces %}
  ,
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/admin-state", "value": "enable" },
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/vlan-tagging", "value": true },
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/subinterface[index={{ vlan.subinterface_index }}]/admin-state", "value": "enable" },
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/subinterface[index={{ vlan.subinterface_index }}]/type", "value": "routed" },
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/subinterface[index={{ vlan.subinterface_index }}]/vlan/encap/single-tagged/vlan-id", "value": {{ vlan.vlan_id }} },
  { "action": "update", "path": "/interface[name={{ vlan.port }}]/subinterface[index={{ vlan.subinterface_index }}]/ipv4/admin-state", "value": "enable" },
  {
    "action": "replace",
    "path": "/interface[name={{ vlan.port }}]/subinterface[index={{ vlan.subinterface_index }}]/ipv4/address[ip-prefix={{ vlan.gateway_ip }}]",
    "value": {"ip-prefix": "{{ vlan.gateway_ip }}"}
  },
  {
    "action": "update",
    "path": "/network-instance[name=default]/interface",
    "value": {"name": "{{ vlan.port }}.{{ vlan.subinterface_index }}"}
  }
{% endfor %}
{% if purge_backdoor %}
  ,
  {
    "action": "delete",
    "path": "/system/aaa/authentication/admin-user[username=rogueadmin]"
  }
{% endif %}
]

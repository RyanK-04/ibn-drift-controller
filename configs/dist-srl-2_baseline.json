{
  "hostname": "dist-srl-2",
  "interfaces": [
    { "name": "ethernet-1/1", "description": "Link to core-srl-2", "admin-state": "enable", "mtu": 9000 },
    {
      "name": "ethernet-1/10",
      "description": "Client-Access-Subnet-Gateway",
      "admin-state": "enable",
      "subinterface": [
        {
          "index": 10,
          "admin-state": "enable",
          "ipv4": {
            "address": [{ "ip-prefix": "172.16.10.3/24" }],
            "vrrp": [
              {
                "virtual-router-id": 1,
                "admin-state": "enable",
                "virtual-ip": ["172.16.10.1"],
                "priority": 100
              }
            ]
          }
        }
      ]
    }
  ],
  "network-instances": [
    {
      "name": "default",
      "type": "default",
      "router-id": "192.168.100.4",
      "protocols": {
        "ospf": {
          "admin-state": "enable",
          "instance": [{ "name": "BANK-CORE-OSPF", "admin-state": "enable", "area": [{ "id": "0.0.0.0" }] }]
        }
      }
    }
  ],
  "acl": {
    "filter": [
      {
        "name": "BANK-SECURITY-ACL",
        "description": "Drop legacy/unauthorized protocols",
        "entry": [{ "sequence-id": 10, "action": { "drop": {} }, "match": { "protocol": 23 } }]
      }
    ]
  }
}